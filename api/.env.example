# Server-side only. Never put Shopify or Google credentials in the Angular app.

# Shopify catalog is opt-in. Enable only after deployment configuration is ready.
SHOPIFY_STORE_DOMAIN=pyesre-rc.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_CATALOG_ENABLED=false

# Google Sheets remains the source for auth/contact details when the Shopify
# catalog is enabled. Use a service-account key or api/credentials.json locally.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
USER_SHEET_NAME=
DIAMOND_SHEET_NAME=natural
RING_SETTING_SHEET_NAME=Ring Setting

# Auth and API access
JWT_SECRET=
ALLOWED_ORIGIN=
PORT=3000

# SMTP for contact and consultation forms
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=info@yanigadiamond.com
CONSULT_TO_EMAIL=info@yanigadiamond.com
